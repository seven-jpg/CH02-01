{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CRAG-MM M3 v1 artifact contract",
  "description": "M3 v1 contract. scripts/check_artifacts.py checks schemas, IDs, hashes and cross-file states; real-source authenticity still needs manual review.",
  "$defs": {
    "requests": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "m3.v1"
        },
        "subset": {
          "enum": [
            "smoke",
            "dev",
            "eval"
          ]
        },
        "interaction_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "query_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "baseline": {
          "enum": [
            "B0",
            "B1"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "messages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "enum": [
                  "system",
                  "user"
                ]
              },
              "content": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "role",
              "content"
            ],
            "additionalProperties": false
          }
        },
        "evidence_used": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "doc_id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "doc_id",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "subset",
        "interaction_id",
        "dataset_manifest_sha256",
        "query_sha256",
        "baseline",
        "run_id",
        "prompt_sha256",
        "messages",
        "evidence_used"
      ],
      "additionalProperties": false
    },
    "questions": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "m3.v1"
        },
        "subset": {
          "enum": [
            "smoke",
            "dev",
            "eval"
          ]
        },
        "interaction_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "subset",
        "interaction_id",
        "dataset_manifest_sha256",
        "session_id",
        "query"
      ],
      "additionalProperties": false
    },
    "answers": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "m3.v1"
        },
        "subset": {
          "enum": [
            "smoke",
            "dev",
            "eval"
          ]
        },
        "interaction_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ground_truth": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "subset",
        "interaction_id",
        "dataset_manifest_sha256",
        "ground_truth"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "m3.v1"
        },
        "subset": {
          "enum": [
            "smoke",
            "dev",
            "eval"
          ]
        },
        "interaction_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "source_interaction_id": {
          "type": "string",
          "minLength": 1
        },
        "source_dataset": {
          "type": "string",
          "minLength": 1
        },
        "source_split": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "turn_index": {
          "type": "integer",
          "minimum": 0
        },
        "domain": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "query_category": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "image_group_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_egocentric": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "schema_version",
        "subset",
        "interaction_id",
        "dataset_manifest_sha256",
        "session_id",
        "source_interaction_id",
        "source_dataset",
        "source_split",
        "source_revision",
        "turn_index",
        "domain",
        "query_category",
        "image_group_id",
        "is_egocentric"
      ],
      "additionalProperties": true
    },
    "hit": {
      "type": "object",
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": [
            "number",
            "null"
          ]
        },
        "score_kind": {
          "enum": [
            "similarity",
            "distance",
            "unknown"
          ]
        }
      },
      "required": [
        "rank",
        "doc_id",
        "url",
        "title",
        "text",
        "score",
        "score_kind"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "m3.v1"
        },
        "subset": {
          "enum": [
            "smoke",
            "dev",
            "eval"
          ]
        },
        "interaction_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "query_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "retrieval_status": {
          "enum": [
            "ok",
            "empty",
            "error"
          ]
        },
        "retrieval_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "index_revision": {
          "type": "string",
          "minLength": 1
        },
        "encoder_revision": {
          "type": "string",
          "minLength": 1
        },
        "latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "hits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hit"
          }
        }
      },
      "required": [
        "schema_version",
        "subset",
        "interaction_id",
        "dataset_manifest_sha256",
        "query_sha256",
        "run_id",
        "retrieval_status",
        "retrieval_config_sha256",
        "index_revision",
        "encoder_revision",
        "latency_ms",
        "error_code",
        "hits"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "retrieval_status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "hits": {
                "minItems": 1
              },
              "error_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "retrieval_status": {
                "enum": [
                  "empty",
                  "error"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "hits": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "retrieval_status": {
                "const": "empty"
              }
            }
          },
          "then": {
            "properties": {
              "error_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "retrieval_status": {
                "const": "error"
              }
            }
          },
          "then": {
            "properties": {
              "error_code": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "predictions": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "m3.v1"
        },
        "subset": {
          "enum": [
            "smoke",
            "dev",
            "eval"
          ]
        },
        "interaction_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "query_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "baseline": {
          "enum": [
            "B0",
            "B1"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "generation_status": {
          "enum": [
            "ok",
            "error",
            "blocked"
          ]
        },
        "agent_response": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "generation_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "retrieval_config_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_status": {
          "enum": [
            "not_used",
            "ok",
            "empty",
            "error",
            "missing"
          ]
        },
        "prompt_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "usage": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "output_tokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "input_tokens",
            "output_tokens"
          ],
          "additionalProperties": false
        },
        "latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "schema_version",
        "subset",
        "interaction_id",
        "dataset_manifest_sha256",
        "query_sha256",
        "baseline",
        "run_id",
        "generation_status",
        "agent_response",
        "provider",
        "model",
        "generation_config_sha256",
        "retrieval_config_sha256",
        "evidence_status",
        "prompt_sha256",
        "usage",
        "latency_ms",
        "error_code"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "generation_status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "agent_response": {
                "type": "string",
                "minLength": 1
              },
              "prompt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "error_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "generation_status": {
                "enum": [
                  "error",
                  "blocked"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "agent_response": {
                "type": "null"
              },
              "error_code": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "baseline": {
                "const": "B0"
              }
            }
          },
          "then": {
            "properties": {
              "retrieval_config_sha256": {
                "type": "null"
              },
              "evidence_status": {
                "const": "not_used"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "baseline": {
                "const": "B1"
              },
              "generation_status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "retrieval_config_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "evidence_status": {
                "enum": [
                  "ok",
                  "empty"
                ]
              }
            }
          }
        }
      ]
    },
    "scores": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "m3.v1"
        },
        "subset": {
          "enum": [
            "smoke",
            "dev",
            "eval"
          ]
        },
        "interaction_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "baseline": {
          "enum": [
            "B0",
            "B1"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "source_generation_run_id": {
          "type": "string",
          "minLength": 1
        },
        "judge_status": {
          "enum": [
            "ok",
            "error",
            "unscored"
          ]
        },
        "verdict": {
          "enum": [
            "CORRECT",
            "WRONG",
            "MISSING",
            null
          ]
        },
        "score": {
          "enum": [
            1,
            -1,
            0,
            null
          ]
        },
        "agent_response_scored": {
          "type": [
            "string",
            "null"
          ]
        },
        "scoring_method": {
          "enum": [
            "exact_match",
            "idk",
            "llm",
            "manual",
            "unscored"
          ]
        },
        "judge_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "evaluation_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "response_tokenizer": {
          "type": "string",
          "minLength": 1
        },
        "response_max_tokens": {
          "const": 75
        },
        "judge_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "schema_version",
        "subset",
        "interaction_id",
        "dataset_manifest_sha256",
        "baseline",
        "run_id",
        "source_generation_run_id",
        "judge_status",
        "verdict",
        "score",
        "agent_response_scored",
        "scoring_method",
        "judge_model",
        "evaluation_config_sha256",
        "response_tokenizer",
        "response_max_tokens",
        "judge_reason",
        "error_code"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "judge_status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "verdict": {
                "enum": [
                  "CORRECT",
                  "WRONG",
                  "MISSING"
                ]
              },
              "score": {
                "enum": [
                  1,
                  -1,
                  0
                ]
              },
              "agent_response_scored": {
                "type": "string",
                "minLength": 1
              },
              "error_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "judge_status": {
                "enum": [
                  "error",
                  "unscored"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "verdict": {
                "type": "null"
              },
              "score": {
                "type": "null"
              },
              "error_code": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "CORRECT"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "const": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "WRONG"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "const": -1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "MISSING"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "subset": {
      "type": "object",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "ids",
        "count"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "m3.v1"
        },
        "data_origin": {
          "const": "official"
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "const": 42
        },
        "grouping": {
          "type": "string",
          "minLength": 1
        },
        "id_rule": {
          "type": "string",
          "minLength": 1
        },
        "subsets": {
          "type": "object",
          "properties": {
            "smoke": {
              "$ref": "#/$defs/subset"
            },
            "dev": {
              "$ref": "#/$defs/subset"
            },
            "eval": {
              "$ref": "#/$defs/subset"
            }
          },
          "required": [
            "smoke",
            "dev",
            "eval"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "data_origin",
        "dataset_id",
        "revision",
        "split",
        "seed",
        "grouping",
        "id_rule",
        "subsets"
      ],
      "additionalProperties": true
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/requests"
    },
    {
      "$ref": "#/$defs/questions"
    },
    {
      "$ref": "#/$defs/answers"
    },
    {
      "$ref": "#/$defs/metadata"
    },
    {
      "$ref": "#/$defs/evidence"
    },
    {
      "$ref": "#/$defs/predictions"
    },
    {
      "$ref": "#/$defs/scores"
    },
    {
      "$ref": "#/$defs/manifest"
    }
  ]
}
